{
  "uid": "updates",
  "title": "Updates",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "mtg_meta_scraper"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Today",
      "description": "Whether an update completed today (Europe/Rome). It retries 4 times, 15 minutes apart.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH runs AS (\n  -- The attempts started today (Europe/Rome).\n  SELECT status FROM update_run\n  WHERE (started_at AT TIME ZONE 'Europe/Rome')::date = (now() AT TIME ZONE 'Europe/Rome')::date\n)\nSELECT CASE\n  WHEN EXISTS (SELECT 1 FROM runs WHERE status = 'ok') THEN 'Updated'\n  WHEN EXISTS (SELECT 1 FROM runs WHERE status = 'failed')\n    THEN 'Failing · ' || (SELECT count(*) FROM runs WHERE status = 'failed') || ' failed'\n  ELSE 'Not yet'\nEND AS \"Today\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^Updated$",
                "result": {
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^Failing.*",
                "result": {
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^Not yet$",
                "result": {
                  "color": "orange",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last update",
      "description": "When the daily update last ran (Europe/Rome time) and whether it succeeded.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(\n  (SELECT to_char(finished_at AT TIME ZONE 'Europe/Rome', 'YYYY-MM-DD HH24:MI') || ' · ' || status\n   FROM update_run ORDER BY id DESC LIMIT 1), 'never') AS \"Last update\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed attempts",
      "description": "Failed update attempts in the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Failed attempts\"\nFROM update_run\nWHERE status = 'failed' AND started_at BETWEEN $__timeFrom() AND $__timeTo()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events in error",
      "description": "Event pages whose last scrape raised an error. The backfill retries them up to 3 times.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Events in error\"\nFROM scan_state\nWHERE status = 'error'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto",
        "showPercentChange": false,
        "wideLayout": true
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Attempts per day",
      "description": "Update attempts by the day they started (Europe/Rome). More than one means retries.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', started_at AT TIME ZONE 'Europe/Rome') AS time,\n  count(*) FILTER (WHERE status = 'ok') AS \"OK\",\n  count(*) FILTER (WHERE status = 'failed') AS \"Failed\"\nFROM update_run\nWHERE started_at BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "OK"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Events per day",
      "description": "Tournaments stored for each day, by format. A format that stops showing up points at a parsing problem.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT event_date::timestamp AS time, format_code AS metric, count(*) AS value\nFROM event\nWHERE event_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\nGROUP BY 1, 2\nORDER BY 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "barAlignment": 0,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Event errors",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "description": "Event pages whose last scrape raised an error, most recent first. The backfill retries each one up to 3 times; the error is in the scraper log.",
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  event_id AS \"Event\",\n  format_label AS \"Format\",\n  event_date AS \"Date\",\n  attempts AS \"Attempts\",\n  updated_at AS \"Last try\"\nFROM scan_state\nWHERE status = 'error'\nORDER BY updated_at DESC, event_id DESC\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No events in error.",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Event"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open on MTGTop8",
                    "targetBlank": true,
                    "url": "https://mtgtop8.com/event?e=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempts"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Date"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last try"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Attempts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mtg-meta-scraper-db"
      },
      "description": "Every update attempt in the selected time range, newest first. Pages: event pages scanned.",
      "gridPos": {
        "h": 10,
        "w": 15,
        "x": 9,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mtg-meta-scraper-db"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  started_at AS \"Started\",\n  attempt AS \"Attempt\",\n  status AS \"Status\",\n  extract(epoch FROM finished_at - started_at) AS \"Duration\",\n  scanned AS \"Pages\",\n  error AS \"Error\"\nFROM update_run\nWHERE started_at BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY started_at DESC, id DESC\nLIMIT 500"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No update attempts in this time range.",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Started"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              },
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Attempt"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pages"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Error"
            },
            "properties": [
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    }
  ]
}
