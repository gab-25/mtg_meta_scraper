            "text": "14 days",
            "value": "14 days",
            "selected": true
          },
          {
            "text": "30 days",
            "value": "30 days",
            "selected": false
          }
        ]
      },
      {
        "name": "min_decks",
        "label": "Minimum decks",
        "type": "textbox",
        "query": "5",
        "current": {
          "text": "5",
          "value": "5"
        },
        "options": [
          {
