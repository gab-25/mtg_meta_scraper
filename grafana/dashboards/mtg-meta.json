{
  "uid": "mtg-meta",
  "title": "MTG Meta",
  "tags": [
    "mtg"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "format",
        "label": "Format",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "mtg-meta-scraper-db"
        },
        "refresh": 1,
        "query": "SELECT code AS __value, name AS __text FROM format ORDER BY name",
        "definition": "SELECT code AS __value, name AS __text FROM format ORDER BY name",
        "current": {
          "text": "Modern",
          "value": "MO"
        }
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "custom",
        "query": "7 days,14 days,30 days",
        "current": {
          "text": "7 days",
          "value": "7 days"
        },
        "options": [
          {
            "text": "7 days",
            "value": "7 days",
            "selected": true
          },
          {
            "text": "14 days",
            "value": "14 days",
            "selected": false
          },
          {
            "text": "30 days",
            "value": "30 days",
            "selected": false
          }
        ]
      },
      {
        "name": "top_n",
        "label": "Top N archetypes",
        "type": "textbox",
        "query": "10",
        "current": {
          "text": "10",
          "value": "10"
        },
        "options": [
          {
            "text": "10",
            "value": "10",
            "selected": true
          }
        ]
      },
      {
        "name": "period",
        "label": "'Rising' period",
        "type": "custom",
        "query": "14 days,30 days",
