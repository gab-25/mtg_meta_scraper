# Copy to .env and adjust as needed
# Grafana login (the only account; anonymous access and sign-up are off).
GF_ADMIN_PASSWORD=admin
# Read-only role Grafana uses to query the database; the scraper's migrations create it when missing.
# Generate one with: python -c 'import secrets; print(secrets.token_urlsafe(24))'
MTG_META_SCRAPER_DB_READER_PASSWORD=change-me
MTG_META_SCRAPER_REQUEST_INTERVAL=1.5
MTG_META_SCRAPER_BACKFILL_DAYS=30
MTG_META_SCRAPER_FORMATS=ST,PI,MO,LE,VI,PAU,EDH,cEDH
MTG_META_SCRAPER_RECHECK_DAYS=3
MTG_META_SCRAPER_UPDATE_HOUR_UTC=6
